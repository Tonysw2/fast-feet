generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  WAITING
  PICKED_UP
  DELIVERED
  RETURNED
}

model Admin {
  id       String @id @default(uuid())
  name     String
  cpf      String @unique
  password String

  @@map("admins")
}

model Courier {
  id       String  @id @default(uuid())
  name     String
  cpf      String  @unique
  password String
  orders   Order[]

  @@map("couriers")
}

model Recipient {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  orders        Order[]
  notifications Notification[]

  @@map("recipients")
}

model Attachment {
  id    String @id @default(uuid())
  title String
  url   String

  order Order?

  @@map("attachments")
}

model Order {
  id                String      @id @default(uuid())
  title             String
  status            OrderStatus @default(WAITING)
  attachmentId      String?     @unique
  deliveryLatitude  Float
  deliveryLongitude Float
  recipientId       String
  courierId         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  recipient  Recipient   @relation(fields: [recipientId], references: [id])
  courier    Courier?    @relation(fields: [courierId], references: [id])
  attachment Attachment? @relation(fields: [attachmentId], references: [id])

  @@map("orders")
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipientId String

  recipient Recipient @relation(fields: [recipientId], references: [id])

  @@map("notifications")
}
